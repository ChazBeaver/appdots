# Ignore file with local/personal address within the configuration
active/macos/.config/nvim/lua/plugins/vimwiki.lua
active/shared/.config/nvim/lua/plugins/vimwiki.lua
active/linux/.config/nvim/lua/plugins/vimwiki.lua
active/shared/.config/nvim/lua/plugins/lualine.lua
active/shared/.config/nvim/lua/plugins/rose-pine-theme.lua
active/shared/.config/nvim/lua/plugins/kanagawa-theme.lua
active/shared/HOME/zsh/zsh_modules/macos/work.sh
active/shared/.config/nvim/colors/active
active/shared/.config/kitty/themes
active/shared/.config/kitty/kitty.conf
# active/linux/.config/nvim/lazy-lock.json
# active/shared/.config/nvim/lazy-lock.json
# active/macos/.config/nvim/lazy-lock.json
active/macos/.config/nvim/theme.txt
active/linux/.config/nvim/lazy-lock.json
active/macos/.config/nvim/lazy-lock.json

# Never persist credentials, password-manager state, key containers, or shell history.
*.kdb
*.kdbx
*.keyx
**/.config/keepassxc/
**/.cache/keepassxc/
**/keepassxc.ini
**/KeePass.config.xml
**/.mono/keypairs/
**/.zsh_history
**/.bash_history
