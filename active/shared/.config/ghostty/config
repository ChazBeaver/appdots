## ADD THIS TO ENABLE GHOSTTY TO WORK ON MAC
## LOCATION: "/Users/<USERNAME>/Library/Application Support/com.mitchellh.ghostty/config"
## Font
#font-family = "FiraCode Nerd Font"
#font-style = Regular
#font-size = 24
#
## Background
#background = 101214
#background-opacity = 1
#
## Local macOS override while ghostty-shell is unavailable
#command = /bin/zsh

# Dynamic theme colors
config-file = ?"~/.local/state/omarchy/current/theme/ghostty.conf"

# Always start Zsh through the appdots-managed availability check.
command = ghostty-shell

# Font
font-family = "FiraCode Nerd Font"
font-style = Regular
font-size = 12

# Window
window-theme = ghostty
window-padding-x = 14
window-padding-y = 14
confirm-close-surface=false
resize-overlay = never
gtk-toolbar-style = flat

# Cursor styling
cursor-style = "bar"
cursor-style-blink = true
adjust-cursor-thickness = 50%

# Shell integration (remove no-cursor while testing cursor behavior)
shell-integration-features = ssh-env

# Keyboard bindings
keybind = shift+insert=paste_from_clipboard
keybind = control+insert=copy_to_clipboard
# Send Shift+Enter as CSI-u so TUIs can distinguish it from Enter.
keybind = shift+enter=csi:13;2u
# Legacy encoding sends Alt+Shift+Enter the same as Alt+Enter; send CSI-u so tmux can match M-S-Enter.
keybind = alt+shift+enter=csi:13;4u
keybind = super+control+shift+alt+arrow_down=resize_split:down,100
keybind = super+control+shift+alt+arrow_up=resize_split:up,100
keybind = super+control+shift+alt+arrow_left=resize_split:left,100
keybind = super+control+shift+alt+arrow_right=resize_split:right,100

# Slowdown mouse scrolling
mouse-scroll-multiplier = 0.95

# Cursor trail shader
custom-shader = shaders/cursor_warp.glsl
# custom-shader = shaders/rectangle_boom_cursor.glsl
custom-shader-animation = always

# Fix general slowness on hyprland (https://github.com/ghostty-org/ghostty/discussions/3224)
async-backend = epoll
